/* ============================================================
   CSR Dashboard — shared design system, v3
   Minimal & polished: one typeface, quiet neutral palette,
   restrained accent, thin borders instead of shadows/gradients,
   generous whitespace.
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap');

:root {
  --bg: #FFFFFF;
  --surface: #FFFFFF;
  --surface-subtle: #FAFAFA;
  --border: #EAEAEA;
  --border-strong: #D8D8D8;
  --text: #171717;
  --text-muted: #737373;
  --text-faint: #A3A3A3;

  --accent: #3B4CCA;
  --accent-quiet: #F2F3FC;

  --good: #1E8E5A;
  --good-quiet: #EBF7F1;
  --warn: #B9770E;
  --warn-quiet: #FBF3E5;
  --bad: #C0392B;
  --bad-quiet: #FBEDEB;

  --radius: 8px;
  --radius-sm: 6px;

  --font: 'Inter', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  font-size: 14.5px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ============================================================
   App bar — plain, quiet, no gradient
   ============================================================ */

.appbar {
  border-bottom: 1px solid var(--border);
  padding: 0 28px;
  display: flex;
  align-items: center;
  gap: 28px;
  height: 58px;
  position: sticky;
  top: 0;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(6px);
  z-index: 30;
}

.appbar .brand {
  font-weight: 600;
  font-size: 14.5px;
  color: var(--text);
  letter-spacing: -0.01em;
}

.appbar .nav-links {
  display: flex;
  gap: 22px;
  flex: 1;
}

.appbar .nav-links a {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 13.5px;
  font-weight: 500;
  padding: 4px 0;
  border-bottom: 1.5px solid transparent;
}
.appbar .nav-links a:hover { color: var(--text); }
.appbar .nav-links a.active { color: var(--text); border-bottom-color: var(--text); }

.appbar .role-chip {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-muted);
  border: 1px solid var(--border);
  padding: 3px 10px;
  border-radius: 20px;
}

.appbar .logout-btn {
  background: none;
  color: var(--text-muted);
  border: none;
  font-size: 13px;
  font-weight: 500;
  padding: 4px 0;
  cursor: pointer;
  box-shadow: none;
}
.appbar .logout-btn:hover { color: var(--text); box-shadow: none; transform: none; }

/* ============================================================
   Page shell
   ============================================================ */

.page {
  max-width: 720px;
  margin: 0 auto;
  padding: 44px 24px 100px;
}

.page.narrow {
  max-width: 360px;
  padding-top: 0;
}

.center-screen {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

h1, h2, h3 {
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 0 0 4px;
  color: var(--text);
}

h1 { font-size: 20px; font-weight: 600; }
h2 { font-size: 16px; margin-top: 32px; }
h3.section-label {
  font-size: 11.5px;
  color: var(--text-faint);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  margin-top: 40px;
  margin-bottom: 14px;
  font-weight: 600;
}

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

.greeting-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 28px;
}

.avatar-ring {
  width: 34px; height: 34px;
  border-radius: 50%;
  background: var(--accent-quiet);
  color: var(--accent);
  display: flex; align-items: center; justify-content: center;
  font-weight: 600;
  font-size: 13px;
  flex-shrink: 0;
}

.greeting-text .name { font-weight: 600; font-size: 15.5px; }
.greeting-text .role { font-size: 12.5px; color: var(--text-faint); }

/* ============================================================
   KPI stat cards
   ============================================================ */

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 10px;
}

.kpi-card {
  background: var(--surface);
  padding: 18px 20px;
}

.kpi-card .kpi-label {
  font-size: 11.5px;
  color: var(--text-faint);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 8px;
}

.kpi-card .kpi-value {
  font-size: 24px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.02em;
}

.kpi-card .kpi-value.accent { color: var(--accent); }
.kpi-card .kpi-value.good { color: var(--good); }
.kpi-card .kpi-value.warn { color: var(--warn); }
.kpi-card .kpi-value.bad { color: var(--bad); }

.kpi-card .kpi-sub { font-size: 11.5px; color: var(--text-faint); margin-top: 4px; }

.mini-table {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 10px;
}
.mini-table .row {
  display: flex;
  justify-content: space-between;
  padding: 10px 16px;
  font-size: 13px;
  border-bottom: 1px solid var(--border);
}
.mini-table .row:last-child { border-bottom: none; }
.mini-table .row .k { color: var(--text-muted); }
.mini-table .row .v { font-family: var(--font-mono); font-size: 12.5px; }

/* ============================================================
   Panels & cards
   ============================================================ */

.panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 22px;
  margin-bottom: 12px;
}

.form-box {
  background: var(--surface-subtle);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 22px;
  margin-bottom: 24px;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 18px;
  margin-bottom: 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10px;
  flex-wrap: wrap;
}

.card .title { font-weight: 600; font-size: 14.5px; }

.meta { color: var(--text-faint); font-size: 12.5px; }

.field-label {
  font-weight: 600;
  font-size: 11px;
  color: var(--text-faint);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-top: 4px;
  margin-bottom: 6px;
}

/* ============================================================
   Score indicator — quiet dot + number, not a loud ring/badge
   ============================================================ */

.score-ring {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-weight: 500;
  font-size: 13px;
  color: var(--text);
}
.score-ring::before {
  content: "";
  width: 7px; height: 7px;
  border-radius: 50%;
  background: currentColor;
}
.score-ring.good { color: var(--good); }
.score-ring.warn { color: var(--warn); }
.score-ring.bad { color: var(--bad); }
.score-ring.neutral { color: var(--text-faint); }

.score-badge {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-mono);
  font-weight: 500;
  font-size: 12.5px;
  padding: 2px 9px;
  border-radius: 20px;
}
.score-badge.good { background: var(--good-quiet); color: var(--good); }
.score-badge.warn { background: var(--warn-quiet); color: var(--warn); }
.score-badge.bad { background: var(--bad-quiet); color: var(--bad); }
.score-badge.neutral { background: var(--surface-subtle); color: var(--text-muted); }

.status-tag {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 20px;
  font-size: 11.5px;
  font-weight: 500;
}
.status-tag.Scheduled, .status-tag.Active { background: var(--accent-quiet); color: var(--accent); }
.status-tag.Completed { background: var(--good-quiet); color: var(--good); }
.status-tag.Cancelled, .status-tag.Inactive { background: var(--bad-quiet); color: var(--bad); }
.status-tag.Rescheduled { background: var(--warn-quiet); color: var(--warn); }

/* ============================================================
   Form elements
   ============================================================ */

input, textarea, select {
  font-family: var(--font);
  font-size: 13.5px;
  padding: 9px 11px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--text);
  width: 100%;
  margin-bottom: 10px;
}

input:focus, textarea:focus, select:focus {
  outline: none;
  border-color: var(--accent);
}

.inline-fields { display: flex; gap: 8px; }
.inline-fields input, .inline-fields select { margin-bottom: 10px; }

button {
  font-family: var(--font);
  font-weight: 500;
  font-size: 13px;
  padding: 8px 15px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--text);
  background: var(--text);
  color: #fff;
  cursor: pointer;
}
button:hover { background: #000; border-color: #000; }

button.secondary {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--border-strong);
}
button.secondary:hover { background: var(--surface-subtle); }

button.danger { background: var(--bad); border-color: var(--bad); }
button.danger:hover { background: #a5311f; }

.btn-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }

/* ============================================================
   Utility
   ============================================================ */

.error { color: var(--bad); font-size: 13px; margin-top: 6px; }
.msg { color: var(--good); font-size: 13px; margin-top: 6px; }
.muted { color: var(--text-faint); }

.pagination {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
  font-size: 12.5px;
  color: var(--text-faint);
}

.autocomplete-wrap { position: relative; }
.suggestions {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: 0 4px 14px rgba(0,0,0,0.06);
  z-index: 20;
  display: none;
  max-height: 220px;
  overflow-y: auto;
}
.suggestions div { padding: 8px 12px; cursor: pointer; font-size: 13px; }
.suggestions div:hover { background: var(--surface-subtle); }

.edit-box {
  display: none;
  margin-top: 10px;
  padding: 14px;
  background: var(--surface-subtle);
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
}
.edit-box.open { display: block; }

.admin-tool {
  margin-top: 40px;
  padding: 18px 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.admin-tool h3 { color: var(--text); margin-top: 0; font-size: 13.5px; }

.empty-state {
  text-align: center;
  padding: 40px 20px;
  color: var(--text-faint);
  font-size: 13.5px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

@media (max-width: 480px) {
  .page { padding: 28px 16px 60px; }
  .inline-fields { flex-direction: column; }
  .appbar { padding: 0 16px; gap: 16px; }
  .appbar .nav-links { gap: 14px; }
}
